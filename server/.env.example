# Renomeie este arquivo para .env e preencha com seus dados
# Nunca compartilhe o MP_ACCESS_TOKEN com ninguém!

# Pegue em: https://www.mercadopago.com.br/developers → Suas integrações → Credenciais
MP_ACCESS_TOKEN=SEU_ACCESS_TOKEN_AQUI

# URL pública da sua loja (sem barra no final). Ex:
# FRONTEND_URL=https://seu-usuario.github.io/Yurepinturas
FRONTEND_URL=https://SUA-LOJA-AQUI

# Porta local (só para testar no computador)
PORT=3001
